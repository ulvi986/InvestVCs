{
  "manifest_version": 3,
  "name": "InvestVCS Screener",
  "version": "1.0.0",
  "description": "Screen the company whose website you are on, then hand it to the full InvestVCS analysis.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "Screen this company",
    "default_popup": "popup.html"
  },
  "icons": {
    "128": "icon128.png"
  }
}
