# Copy to .env and fill in. Never commit the filled-in file.

# ── Supabase (frontend, build time) ───────────────────────────────────
VITE_SUPABASE_URL=""
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# ── AI analyst service (frontend, build time) ─────────────────────────
# Public URL of the Python service in ai/. Vite inlines this at build time,
# so on Railway it must be set on the FRONTEND service, not only in this file.
# Locally you can leave it unset: `npm run dev` falls back to the address
# `npm run ai` uses.
VITE_AI_SERVICE_URL="http://127.0.0.1:8123"

# ── AI analyst service (backend, runtime) ─────────────────────────────
# Set these on the Python service. Two surfaces are supported:
#
#   Azure OpenAI resource   -> AZURE_OPENAI_ENDPOINT=https://<res>.openai.azure.com
#   Azure AI Foundry agent  -> AZURE_AI_FOUNDRY_ENDPOINT=<the .../responses URL>
#
# The protocol is detected from the endpoint. Override with AI_PROTOCOL=chat
# or AI_PROTOCOL=responses if detection is ever wrong.
AZURE_AI_FOUNDRY_ENDPOINT=""
AZURE_AI_API_KEY=""
AZURE_OPENAI_API_VERSION="2025-11-15-preview"

# For a Foundry agent this MUST equal the model the agent is pinned to,
# otherwise the service replies 400 "Model must match the agent's model".
AZURE_AI_MODEL="gpt-5-mini"

# Optional tuning.
# AI_PROTOCOL=""
# AI_MOCK="1"                 # canned agent output, no model calls
# AGENT_CONCURRENCY="3"
# AGENT_MAX_ITERATIONS="2"
# LLM_TIMEOUT_SECONDS="120"
# CORS_ORIGINS="https://your-frontend.example"
